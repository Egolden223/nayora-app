# ============================================================
# NAYORA — variables d’environnement (déploiement gratuit)
# ============================================================
# Copie ce fichier en .env.local (dev) ou configure-les dans
# Vercel → Settings → Environment Variables.
# ============================================================

# --- Obligatoire en production ---
# Postgres serverless Neon (https://neon.tech — free tier)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Secret Better Auth (génère une longue chaîne aléatoire)
# openssl rand -hex 32
BETTER_AUTH_SECRET=remplace-par-une-longue-chaine-aleatoire-32-octets-min

# URL publique de l’app (sans slash final)
BETTER_AUTH_URL=https://ton-app.vercel.app
# En local :
# BETTER_AUTH_URL=http://localhost:8080

# Auth activée (recommandé)
VITE_AUTH_ENABLED=true

# --- Optionnel mais recommandé ---
# Resend (https://resend.com — 3000 emails/mois gratuits)
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=NAYORA <noreply@ton-domaine.com>

# Clé xAI pour les icebreakers IA (optionnel)
# XAI_API_KEY=

# --- Développement uniquement ---
# Laisse DATABASE_URL vide pour utiliser PGLite (base embarquée)
# VITE_AUTH_ENABLED=false  → force le mode « utilisateur démo »
